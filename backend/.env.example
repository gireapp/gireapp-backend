# ─── GIREAPP Environment Variables ───
# Copy this file to .env and fill in the values.
# (The server also reads .env.local, but Prisma CLI commands like
#  `prisma migrate dev` / `prisma db push` only read .env — so prefer .env.)

# ── Database (Neon PostgreSQL) ──
DATABASE_URL="postgresql://user:password@host:5432/gireapp?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/gireapp?sslmode=require"

# ── Auth.js / NextAuth ──
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"
# AUTH_TRUST_HOST=true  # Enable in production behind a proxy

# ── Email (Resend) ──
RESEND_API_KEY="re_xxxxxxxxxx"
EMAIL_FROM="GIREAPP <noreply@gireapp.com>"

# ── AWS S3 (Media Uploads) ──

# ── Rate Limiting (Upstash Redis) ──
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Error Monitoring (Sentry) ──
SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""

# ── Application ──
# CORS origin + base URL for links in emails (verification, password reset)
FRONTEND_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="GIREAPP"
NODE_ENV="development"

# Dev/testing only: auto-verifies new accounts and auto-logs-in on register.
# NEVER set this in production.
# SKIP_EMAIL_VERIFICATION="true"

# R2 is S3-compatible, so the AWS SDK is used purely as a protocol client.
# The bucket stays private: uploads and reads both use short-lived signed URLs,
# so no public bucket and no custom domain are required.

# ── Object storage (any S3-compatible provider) ──
# The bucket stays private: uploads and reads both use short-lived signed URLs,
# so no public bucket and no custom domain are required.
#
# Cloudflare R2:  S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
#                 S3_REGION="auto"
# Backblaze B2:   S3_ENDPOINT="https://s3.<region>.backblazeb2.com"
#                 S3_REGION="us-west-004"   (must match the endpoint's region)
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Signed URLs stay on the S3_ENDPOINT origin. Set to "false" only for AWS S3.
S3_FORCE_PATH_STYLE="true"
