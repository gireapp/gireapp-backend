# ─── GIREAPP Environment Variables ───
# Copy this file to .env and fill in the values.
# (The server also reads .env.local, but Prisma CLI commands like
#  `prisma migrate deploy` and seeding only read .env — so prefer .env.)

# ── Database (Neon PostgreSQL) ──
DATABASE_URL="postgresql://user:password@host:5432/gireapp?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/gireapp?sslmode=require"

# ── Auth ──
# Signs sessions. Must be byte-for-byte identical to the frontend's AUTH_SECRET.
AUTH_SECRET="generate-with: openssl rand -base64 32"
# Proves to the rate limiter that a forwarded learner IP came from the frontend's
# server. Must equal the frontend's CLIENT_IP_SECRET. Unset, every learner shares
# one rate-limit bucket.
CLIENT_IP_SECRET="generate-with: openssl rand -base64 32"

# ── Email (Resend) ──
# Key from https://resend.com/api-keys. The backend rejects this placeholder at
# send time rather than failing silently, so a copied-but-unedited value is loud.
RESEND_API_KEY="re_xxxxxxxxxx"

# The From domain must be verified in Resend or every send returns 403
# invalid_from_address. Two working choices:
#   onboarding@resend.dev  — no DNS setup, but only delivers to the address that
#                            owns the Resend account. Fine for solo testing.
#   noreply@gireapp.com    — needs gireapp.com verified in Resend (SPF + DKIM
#                            records at Cloudflare). Required to mail teammates.
EMAIL_FROM="GIREAPP <noreply@gireapp.com>"

# Verify delivery without running the signup flow:
#   npm run email:test -- you@example.com

# Where Contact Support messages go.
SUPPORT_EMAIL="support@gireapp.com"

# ── Application ──
# Exactly ONE origin: the base for links in emails (verification, password
# reset, guardian consent). A comma-separated list here is rejected at startup.
FRONTEND_URL="http://localhost:3000"
# Optional. Extra browser origins allowed by CORS, comma-separated.
# Defaults to FRONTEND_URL alone. e.g. "https://app.gireapp.com,https://staging.gireapp.com"
# CORS_ORIGINS=""
# Must be "production" in production: it sets Secure on auth cookies and stops
# error responses leaking stack traces.
NODE_ENV="development"

# Dev/testing only: auto-verifies new accounts and auto-logs-in on register.
# NEVER set this in production.
# SKIP_EMAIL_VERIFICATION="true"

# ── Object storage (any S3-compatible provider) ──
# The bucket stays private: uploads and reads both use short-lived signed URLs,
# so no public bucket and no custom domain are required.
#
# Any S3-compatible provider works:
# Backblaze B2:   S3_ENDPOINT="https://s3.<region>.backblazeb2.com"
#                 S3_REGION="us-west-004"   (must match the endpoint's region)
# Cloudflare R2:  S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
#                 S3_REGION="auto"
# The bucket also needs a CORS rule letting the site PUT and GET.
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Signed URLs stay on the S3_ENDPOINT origin. Set to "false" only for AWS S3.
S3_FORCE_PATH_STYLE="true"
