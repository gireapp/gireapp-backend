// ─────────────────────────────────────────────────
// GIREAPP — Prisma Schema
// All 10 core models with relations and indexes
// Aligned with PRD v1.0 and MVP Milestone Criteria
// ─────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Enums ──

enum Role {
  STUDENT
  TUTOR
  ADMIN
}

/// Mirrors GuardianConsentStatus in @gireapp/shared — values must stay identical,
/// they are serialised straight into the JWT and API responses.
enum GuardianConsentStatus {
  not_required
  pending
  confirmed
}

enum AcademicLevel {
  SECONDARY
  TERTIARY
  PROFESSIONAL
}

enum ContentType {
  TEXT
  PDF
  MARKDOWN
  VIDEO
}

enum BadgeType {
  BRONZE
  SILVER
  GOLD
  CURRENT_MASTER
}

/// Mirrors QUIZ_DIFFICULTIES in @gireapp/shared — values must stay identical.
enum QuizDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

// ── User ──

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  passwordHash  String
  role          Role           @default(STUDENT)
  academicLevel AcademicLevel?
  department    String? // e.g., "Science", "Undergraduate", "Data Analytics"
  moodTheme     String?        @default("calm")
  points        Int            @default(0)
  emailVerified DateTime?

  // ── Guardian consent (NDPA 2023 / POPIA / Ghana Act 843) ──
  // isMinor is derived from dateOfBirth at read time, never stored, so it cannot
  // go stale. Nullable because rows predating this feature have no DOB.
  dateOfBirth           DateTime?             @db.Date
  guardianEmail         String?
  guardianConsentStatus GuardianConsentStatus @default(not_required)
  guardianConsentToken  String?               @unique
  guardianConsentExpiry DateTime?
  guardianConsentAt     DateTime?
  image                 String?
  deletedAt             DateTime? // Soft delete (M5: BE-ADMIN-005)

  // Verification & reset tokens
  verificationToken  String?   @unique
  verificationExpiry DateTime?
  resetToken         String?   @unique
  resetTokenExpiry   DateTime?

  // Email change in flight. `email` is only rewritten once the link sent to
  // pendingEmail is opened, so an unconfirmed address can never lock anyone out
  // of their own account.
  pendingEmail       String?
  pendingEmailToken  String?   @unique
  pendingEmailExpiry DateTime?

  // Brute-force protection (per-account lockout)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Session cut-off: tokens minted before this instant are rejected by
  // requireAuth, so a password reset ends every session already in flight.
  passwordChangedAt DateTime?

  // Relations
  enrolments     Enrolment[]
  quizAttempts   QuizAttempt[]
  badges         UserBadge[]
  lessonProgress LessonProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([academicLevel, department])
  @@index([email])
  @@index([role])
  @@map("users")
}

// ── Course ──

model Course {
  id            String        @id @default(cuid())
  title         String
  description   String        @db.Text
  academicLevel AcademicLevel
  department    String // Must match user's department for filtering
  thumbnailUrl  String?
  published     Boolean       @default(false)
  createdById   String? // Tutor/Admin who created
  deletedAt     DateTime? // Soft delete

  // Relations
  modules    Module[]
  enrolments Enrolment[]
  quizzes    Quiz[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([academicLevel, department])
  @@index([published])
  @@map("courses")
}

// ── Module ──

model Module {
  id       String @id @default(cuid())
  courseId String
  title    String
  order    Int    @default(0)

  // Relations
  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId, order])
  @@map("modules")
}

// ── Lesson ──

model Lesson {
  id               String      @id @default(cuid())
  moduleId         String
  title            String
  contentType      ContentType @default(TEXT)
  content          String?     @db.Text // For TEXT/MARKDOWN
  mediaUrl         String? // For PDF/VIDEO (S3 URL)
  order            Int         @default(0)
  estimatedMinutes Int         @default(10)

  // Relations
  module   Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress LessonProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([moduleId, order])
  @@map("lessons")
}

// ── Enrolment ──

model Enrolment {
  id       String @id @default(cuid())
  userId   String
  courseId String
  progress Float  @default(0) // 0.0 to 1.0

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, courseId])
  @@map("enrolments")
}

// ── Lesson Progress ──

model LessonProgress {
  id        String  @id @default(cuid())
  userId    String
  lessonId  String
  completed Boolean @default(true)

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, lessonId])
  @@index([userId])
  @@map("lesson_progress")
}

// ── Quiz ──

model Quiz {
  id           String          @id @default(cuid())
  courseId     String
  title        String
  description  String?
  timeLimitMin Int             @default(30) // Timer enforcement (M4)
  passingScore Int             @default(70) // Percentage to pass
  /// Null for quizzes created before difficulty existed — "never set", not a level.
  difficulty   QuizDifficulty?
  /// Drafts are saved by the builder but never served to learners.
  published    Boolean         @default(false)

  // Relations
  course    Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions Question[]
  attempts  QuizAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
  @@index([published])
  @@map("quizzes")
}

// ── Question ──

model Question {
  id          String  @id @default(cuid())
  quizId      String
  text        String  @db.Text
  explanation String? @db.Text // Shown after grading
  order       Int     @default(0)
  /// Weight of this question in the quiz score. 1 keeps every existing
  /// question equally weighted, which is how scores were computed before.
  points      Int     @default(1)

  // Relations
  quiz    Quiz           @relation(fields: [quizId], references: [id], onDelete: Cascade)
  choices AnswerChoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([quizId, order])
  @@map("questions")
}

// ── Answer Choice ──

model AnswerChoice {
  id         String  @id @default(cuid())
  questionId String
  text       String
  isCorrect  Boolean @default(false)
  order      Int     @default(0)

  // Relations
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("answer_choices")
}

// ── Quiz Attempt ──

model QuizAttempt {
  id           String   @id @default(cuid())
  userId       String
  quizId       String
  score        Int // Percentage 0–100
  totalRight   Int
  totalWrong   Int
  answers      Json // { questionId: choiceId } map
  startedAt    DateTime @default(now())
  submittedAt  DateTime @default(now())
  timeTakenSec Int? // Actual seconds spent
  /// Points this attempt actually paid out. Stored rather than recomputed,
  /// because the payout depends on the attempts before it: a quiz pays at
  /// most POINTS.QUIZ_PASS in total, however many times it is retaken.
  pointsEarned Int      @default(0)

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, quizId])
  @@index([quizId])
  /// `startedAt` is the server-issued start ticket's timestamp, so this makes
  /// a ticket single-use: a double-clicked Submit cannot record two attempts.
  @@unique([userId, quizId, startedAt])
  @@map("quiz_attempts")
}

// ── User Badge ──

model UserBadge {
  id        String    @id @default(cuid())
  userId    String
  badgeType BadgeType
  courseId  String? // Which course the badge was earned for
  earnedAt  DateTime  @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeType, courseId])
  @@map("user_badges")
}
